<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Antigravity Hub" Width="1220" Height="800" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#101214" Foreground="#F0F2F3" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#181B1F"/>
    <SolidColorBrush x:Key="Line" Color="#30363D"/>
    <SolidColorBrush x:Key="Muted" Color="#A6AFBA"/>
    <SolidColorBrush x:Key="Accent" Color="#7EE2B8"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F0F2F3"/></Style>
    <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style x:Key="ModernBtn" TargetType="Button">
      <Setter Property="Background" Value="#252A30"/><Setter Property="Foreground" Value="#F0F2F3"/><Setter Property="BorderBrush" Value="#424B56"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#7EE2B8"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#7EE2B8"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#10271F"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}"/>
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}"><Setter Property="Foreground" Value="#FFADB6"/><Setter Property="Background" Value="Transparent"/></Style>
    <Style x:Key="TitleBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="42"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8"/></Style>
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#A6AFBA"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="NavBox" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavBox" Property="Background" Value="#20382E"/><Setter Property="Foreground" Value="#9CEDCA"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBox" Property="BorderBrush" Value="#526171"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBox" Property="BorderBrush" Value="#7EE2B8"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#101214"/><Setter Property="Foreground" Value="#F0F2F3"/><Setter Property="BorderBrush" Value="#526171"/><Setter Property="CaretBrush" Value="#7EE2B8"/><Setter Property="Padding" Value="10,7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="36"/></Style>
    <Style TargetType="ProgressBar"><Setter Property="Height" Value="5"/><Setter Property="Background" Value="#343B44"/><Setter Property="Foreground" Value="#7EE2B8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Maximum" Value="100"/></Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F0F2F3"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#292E35"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="RowHeight" Value="56"/>
      <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#181B1F"/><Setter Property="Foreground" Value="#A6AFBA"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,14"/><Setter Property="BorderBrush" Value="#30363D"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="#181B1F"/><Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#22282E"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#24382F"/></Trigger><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#1B2B25"/></DataTrigger></Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F0F2F3"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#34463E"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#181B1F"/><Setter Property="Width" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#526171" CornerRadius="3" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Horizontal"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#526171" CornerRadius="3" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Border Background="#101214" BorderBrush="#39414B" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="TitleBar" Background="#14171A" BorderBrush="#30363D" BorderThickness="0,0,0,1">
        <Grid Margin="18,0,6,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="ANTIGRAVITY" FontSize="11" FontWeight="Bold" Foreground="#7EE2B8"/><TextBlock Text=" /  ACCOUNT HUB" FontSize="11" Foreground="#A6AFBA" Margin="8,0,0,0"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BtnMinimize" Style="{StaticResource TitleBtn}" FontFamily="Segoe MDL2 Assets" Content="&#xE921;" ToolTip="Thu nhỏ" AutomationProperties.Name="Thu nhỏ"/><Button x:Name="BtnMaximize" Style="{StaticResource TitleBtn}" FontFamily="Segoe MDL2 Assets" Content="&#xE922;" ToolTip="Phóng to / Khôi phục" AutomationProperties.Name="Phóng to / Khôi phục"/><Button x:Name="BtnClose" Style="{StaticResource TitleBtn}" FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;" ToolTip="Đóng giao diện" AutomationProperties.Name="Đóng giao diện"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="178"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#14171A" BorderBrush="#30363D" BorderThickness="0,0,1,0" Padding="14,24,14,16">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top"><Grid Margin="6,0,0,30"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#7EE2B8" CornerRadius="8" Width="30" Height="30"><Path Data="M 4,20 L 12,2 L 20,20 M 8,13 L 16,13" Stroke="#132B21" StrokeThickness="2" Stretch="Uniform" Margin="7"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Antigravity" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Account Hub" Style="{StaticResource MutedText}"/></StackPanel></Grid>
              <TextBlock Text="KHÔNG GIAN LÀM VIỆC" FontSize="10" Foreground="#A6AFBA" Margin="10,0,0,12"/>
              <RadioButton x:Name="NavAccounts" GroupName="Navigation" IsChecked="True" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" Margin="0,2,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Tài khoản" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
              <RadioButton x:Name="NavHistory" GroupName="Navigation" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Margin="0,2,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Nhật ký xoay" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom"><Border BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="8,18,0,16"><StackPanel><TextBlock Text="CHÍNH SÁCH XOAY" FontSize="10" Foreground="#A6AFBA"/><TextBlock Text="5 giờ &lt; 20%" Margin="0,10,0,4"/><TextBlock Text="Tuần / Argon ≤ 8%"/><TextBlock Text="Chỉ chuyển khi IDE rảnh" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel></Border><Button x:Name="BtnOpenFolder" Style="{StaticResource ModernBtn}" Content="Mở thư mục"/><TextBlock Text="LOCAL DESKTOP" FontSize="10" Foreground="#A6AFBA" Margin="10,16,0,0"/></StackPanel>
            <Grid/>
          </DockPanel>
        </Border>
        <Grid x:Name="ContentArea" Grid.Column="1" Margin="26,24,26,16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid x:Name="HeaderArea" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="PageTitle" Text="Tài khoản" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Quản lý nguồn quota cho phiên làm việc của bạn." Foreground="#A6AFBA" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BtnSaveCurrent" Style="{StaticResource ModernBtn}" Content="Lưu acc hiện tại" Margin="0,0,8,0"/><Button x:Name="BtnAddAccount" Style="{StaticResource PrimaryBtn}" Content="+ Thêm tài khoản"/></StackPanel>
          </Grid>
          <UniformGrid x:Name="StatsArea" Grid.Row="1" Columns="4" Margin="0,0,-12,18">
            <Border Style="{StaticResource Panel}" Margin="0,0,12,0" Padding="16,12"><StackPanel><TextBlock Text="TỔNG TÀI KHOẢN" Style="{StaticResource MutedText}"/><TextBlock x:Name="StatTotal" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,4"/><TextBlock x:Name="HintTotal" Text="Trong kho trên máy này" Style="{StaticResource MutedText}"/></StackPanel></Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,12,0" Padding="16,12"><StackPanel><TextBlock Text="ĐỦ QUOTA" Style="{StaticResource MutedText}"/><TextBlock x:Name="StatReady" Text="—" Foreground="#7EE2B8" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,4"/><TextBlock x:Name="HintReady" Text="5H &gt; 20% · Tuần/Argon &gt; 10%" Style="{StaticResource MutedText}"/></StackPanel></Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,12,0" Padding="16,12"><StackPanel><TextBlock Text="CẦN CHÚ Ý" Style="{StaticResource MutedText}"/><TextBlock x:Name="StatAttention" Text="—" Foreground="#F2C97D" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,4"/><TextBlock x:Name="HintAttention" Text="Quota thấp / Chưa rõ" Style="{StaticResource MutedText}"/></StackPanel></Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,12,0" Padding="16,12"><StackPanel><TextBlock Text="ĐÃ XOAY XÁC MINH" Style="{StaticResource MutedText}"/><TextBlock x:Name="StatRotations" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,4"/><TextBlock x:Name="HintRotations" Text="Trong nhật ký gần đây" Style="{StaticResource MutedText}"/></StackPanel></Border>
          </UniformGrid>
          <Border x:Name="StatusArea" Grid.Row="2" Style="{StaticResource Panel}" BorderBrush="#365347" Background="#18231E" Padding="16,12" Margin="0,0,0,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock x:Name="TxtDaemonStatus" Text="Đang đọc trạng thái…" Foreground="#9CEDCA" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="TxtActiveAccount" Text="Đang xác minh tài khoản trong Antigravity" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"><TextBlock x:Name="TxtUpdated" Text="Chưa quét quota" Style="{StaticResource MutedText}"/><TextBlock Text="Nghỉ 25s giữa các lượt quét nền" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="3">
            <Grid x:Name="AccountsPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><StackPanel><TextBlock Text="TÌM TÀI KHOẢN" FontSize="10" Foreground="#A6AFBA" Margin="0,0,0,6"/><TextBox x:Name="SearchAccounts" Width="220" AutomationProperties.Name="Tìm tài khoản theo tên hoặc email" ToolTip="Tìm theo tên hoặc email"/></StackPanel><StackPanel Margin="14,0,0,0"><TextBlock Text="LỌC TRẠNG THÁI" FontSize="10" Foreground="#A6AFBA" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="FilterAll" GroupName="Filter" IsChecked="True" Tag="All" Content="Tất cả" Style="{StaticResource Nav}" Padding="10,8"/><RadioButton x:Name="FilterReady" GroupName="Filter" Tag="Ready" Content="Đủ quota" Style="{StaticResource Nav}" Padding="10,8"/><RadioButton x:Name="FilterAttention" GroupName="Filter" Tag="Attention" Content="Cần chú ý" Style="{StaticResource Nav}" Padding="10,8"/></StackPanel></StackPanel></StackPanel><Button Grid.Column="1" x:Name="BtnRefresh" Content="Quét quota" Style="{StaticResource ModernBtn}" VerticalAlignment="Bottom"/></Grid>
              <Border Grid.Row="1" Style="{StaticResource Panel}"><Grid><DataGrid x:Name="AccountsContainer" AutomationProperties.Name="Danh sách tài khoản">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="TÀI KHOẢN" Width="2*" MinWidth="175" SortMemberPath="AccountName"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountName}"/><TextBlock Text="{Binding Email}" Foreground="#A6AFBA" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Email}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120" SortMemberPath="StateKey"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="12" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="QUOTA 5 GIỜ" Width="*" MinWidth="95" SortMemberPath="FiveValue"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding FiveText}" FontWeight="SemiBold"/><ProgressBar Value="{Binding FiveValue}" Foreground="{Binding FiveColor}" Margin="0,9,0,0" AutomationProperties.Name="{Binding FiveAccessible}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="QUOTA TUẦN" Width="*" MinWidth="95" SortMemberPath="WeekValue"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding WeekText}" FontWeight="SemiBold"/><ProgressBar Value="{Binding WeekValue}" Foreground="#93B9EE" Margin="0,9,0,0" AutomationProperties.Name="{Binding WeekAccessible}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="QUOTA ARGON" Width="*" MinWidth="95" SortMemberPath="ArgonValue"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding ArgonText}" FontWeight="SemiBold"/><ProgressBar Value="{Binding ArgonValue}" Foreground="{Binding ArgonColor}" Margin="0,9,0,0" AutomationProperties.Name="{Binding ArgonAccessible}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="THAO TÁC" Width="182" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Tag="Switch" Content="Chuyển" IsEnabled="{Binding CanSwitch}" Visibility="{Binding SwitchVisibility}" Style="{StaticResource ModernBtn}" Padding="10,6" Margin="0,0,6,0" ToolTip="Chuyển khi IDE rảnh và đủ quota"/><Button Tag="Verify" Content="Xác minh" Visibility="{Binding VerifyVisibility}" Style="{StaticResource ModernBtn}" Padding="8,6" Margin="0,0,6,0"/><Button Tag="Delete" Content="Xóa" Style="{StaticResource DangerBtn}" Padding="8,6"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid><StackPanel x:Name="EmptyAccounts" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"><TextBlock x:Name="EmptyTitle" Text="Chưa có tài khoản" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="Thêm tài khoản hoặc lưu tài khoản Antigravity đang dùng." Foreground="#A6AFBA" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel></Grid></Border>
              <Grid Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="TxtAccountCount" Text="0 tài khoản" Style="{StaticResource MutedText}"/><TextBlock Text="Bấm tiêu đề cột để sắp xếp" HorizontalAlignment="Right" Style="{StaticResource MutedText}"/></Grid>
            </Grid>
            <Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,14"><TextBlock Text="Chuyển thành công, trì hoãn và các sự kiện cần chú ý." Foreground="#A6AFBA" VerticalAlignment="Center"/><Button x:Name="BtnRefreshHistory" Content="Làm mới nhật ký" Style="{StaticResource ModernBtn}" HorizontalAlignment="Right"/></Grid>
              <Border Grid.Row="1" Style="{StaticResource Panel}"><Grid><DataGrid x:Name="HistoryGrid" RowHeight="64" AutomationProperties.Name="Nhật ký xoay tài khoản"><DataGrid.Columns>
                <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding TimeText}" Width="142" SortMemberPath="Timestamp"/>
                <DataGridTemplateColumn Header="KẾT QUẢ" Width="135" SortMemberPath="Kind"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="{Binding Color}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="TÀI KHOẢN" Binding="{Binding Account}" Width="165"/>
                <DataGridTemplateColumn Header="CHI TIẾT" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#A6AFBA"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyHistory" Text="Chưa có sự kiện xoay trong nhật ký gần đây." Foreground="#A6AFBA" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
              <TextBlock Grid.Row="2" x:Name="TxtHistoryCount" Text="Đang đọc nhật ký…" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
            </Grid>
          </Grid>
          <Border Grid.Row="4" BorderBrush="#30363D" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TxtFooterPath" Text="" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="Đóng cửa sổ vẫn giữ daemon chạy nền" Style="{StaticResource MutedText}" Margin="16,0,0,0"/></Grid></Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
